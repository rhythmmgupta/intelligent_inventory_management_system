# Copy to .env for local non-Docker dev or .env.prod on AWS EC2.
# NEVER commit real secrets or .env files to Git.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongodb:27017/freshguard_inventory
ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=4000

# Replace with >= 32 random characters in staging/production
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Comma-separated allowed browser origins
ALLOWED_ORIGIN=http://localhost,http://localhost:5173,http://localhost:8080

# Optional store date offset in minutes (330 for IST +05:30, 0 for UTC)
STORE_TZ_OFFSET_MINUTES=330

# Seed script configuration (set SEED_ON_EMPTY=false if managing prod users manually)
SEED_ON_EMPTY=true
SEED_USER_PASSWORD=CHANGE_ME_INITIAL_DEMO_PASSWORD
